{
  "compilerOptions": {
    // File layout
    "rootDir": "./src",
    "outDir": "./dist",
	"baseUrl": ".", // TS 7.0 may provide migration guidance, keep for now
	// Use for @ aliases for import
	"paths": {
		"@/*":  ["./src/*"]
	},

    // Env
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],

    // Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Strict checks
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Interop
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
