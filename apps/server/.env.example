# Copy to .env and fill in. .env is gitignored — never commit real secrets.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ft_transcendence"
JWT_SECRET="change-me-to-a-random-string-at-least-32-characters-long"
JWT_EXPIRES_IN="7d"
NODE_ENV="development"
PORT="3001"

# OAuth providers (leave a pair blank to disable that provider; its routes return 503).
# Register each callback URL below in the provider's console.
# Google and GitHub are temporarily disabled — only 42 is wired up.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
FORTYTWO_CLIENT_ID=""
FORTYTWO_CLIENT_SECRET=""

# Server origin providers redirect back to (must match PORT and the registered callback URL:
#   <base>/auth/42/callback)
OAUTH_REDIRECT_BASE_URL="http://localhost:3001"
# Frontend URL to land on after a successful OAuth login.
CLIENT_URL="http://localhost:3000"
