# ============================================================================
# ft_transcendence — environment configuration. Copy to `.env`.
#
# ONE file, TWO run modes:
#   • pnpm dev (local) : loads this entire file as-is.
#   • make    (Docker) : reads only the secrets + ports below; docker-compose.yml
#                        sets NODE_ENV / DATABASE_URL / the public URLs itself.
#
# Literal values only — Node --env-file and dotenv do NOT expand ${...}.
# ============================================================================

# ── REQUIRED — you must set these ───────────────────────────────────────────
JWT_SECRET="change-this-to-a-random-secret-at-least-32-chars"
POSTGRES_PASSWORD=change-this-password        # mirror it in DATABASE_URL below

# ── OPTIONAL — 42 OAuth (leave blank to hide the "Continue with 42" button) ──
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=

# ── OPTIONAL — defaults are fine (used by both Docker and dev) ──────────────
POSTGRES_USER=postgres
POSTGRES_DB=ft_transcendence
POSTGRES_PORT=5432                # host port Postgres is published on
JWT_EXPIRES_IN="7d"              # session token lifetime
# Docker builds every public URL from PUBLIC_HOST + HTTPS_PORT. Set PUBLIC_HOST
# to your LAN IP only if you registered that IP as the 42 redirect URI.
PUBLIC_HOST=localhost
HTTP_PORT=8080
HTTPS_PORT=8443

# ── LOCAL DEV ONLY — Docker ignores all of these ────────────────────────────
# Dev runs the server on :3001 and the client on :3000. Keep DATABASE_URL's
# user/password/db in sync with the POSTGRES_* values above.
DATABASE_URL="postgresql://postgres:change-this-password@localhost:5432/ft_transcendence"
PORT="3001"
NODE_ENV="development"
CLIENT_URL="http://localhost:3000"
# Register this dev callback in your 42 app: http://localhost:3001/auth/42/callback
OAUTH_REDIRECT_BASE_URL="http://localhost:3001"
