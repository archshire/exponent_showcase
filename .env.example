# Single source of truth. Copy to `.env`.
# - Local dev (`pnpm dev`): every app loads this file; the URL values below
#   (localhost) are used as-is.
# - Docker (`make`): docker-compose reads this file for SECRETS, but overrides
#   the host/URL values (DATABASE_URL host, NODE_ENV, CLIENT_URL,
#   OAUTH_REDIRECT_BASE_URL) for the proxied https stack.

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=ft_transcendence
# Host port Postgres is published on (change if 5432 is taken locally).
POSTGRES_PORT=5432

# Dev connection (localhost). In Docker the server builds its own URL against the
# `db` service host. Use literal values here (not ${...}) — the dev server loads
# env via Node --env-file / dotenv, which do NOT expand variables. Keep the
# user/password/db in sync with the POSTGRES_* values above.
DATABASE_URL="postgresql://postgres:change-this-password@localhost:5432/ft_transcendence"

# --- Auth / session ---
JWT_SECRET="change-this-to-a-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"
NODE_ENV="development"
PORT="3001"

# --- OAuth (42) ---
# Leave blank to disable the "Continue with 42" button.
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=

# Dev callback/redirect URLs (server on :3001, client on :3000).
# Docker overrides these using HOST and HTTPS_PORT below.
# Register BOTH callbacks on your 42 app:
#   dev    -> http://localhost:3001/auth/42/callback
#   docker -> https://${HOST}:${HTTPS_PORT}/api/auth/42/callback
OAUTH_REDIRECT_BASE_URL="http://localhost:3001"
CLIENT_URL="http://localhost:3000"

# --- Docker host ports and hostname (compose-only) ---
# Set HOST to your machine's LAN IP if you registered that IP as the
# 42 OAuth redirect URI (e.g. HOST=10.12.6.4). Defaults to localhost.
HTTP_PORT=8080
HTTPS_PORT=8443
HOST=localhost
