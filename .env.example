# Copy to `.env` and adjust. The Docker stack (`make`) reads this file.

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=ft_transcendence

# Used by local (non-Docker) dev tooling such as prisma + ts-node-dev.
# In the Docker stack the server's DATABASE_URL is set to the `db` service host.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}"

# --- Auth / session ---
JWT_SECRET="change-this-to-a-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"
NODE_ENV="development"
PORT="3001"

# --- Public origin (Docker) ---
# Host ports nginx is published on, and the public origin the browser uses.
# CLIENT_URL must match the URL you open in the browser (Socket.IO CORS).
HTTP_PORT=8080
HTTPS_PORT=8443
CLIENT_URL="https://localhost:8443"
OAUTH_REDIRECT_BASE_URL="https://localhost:8443"

# --- OAuth (optional; leave blank to disable the 42 button) ---
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
