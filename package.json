{
  "name": "ft_transcendence",
  "private": true,
  "version": "1.0.0",
  "description": "ft_transcendence monorepo",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "lint": "pnpm -r lint",
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "server:dev": "pnpm -w -C apps/server run dev",
    "server:start": "pnpm -w -C apps/server run start"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  }
}
