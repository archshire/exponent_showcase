{
  "name": "ft_transcendence",
  "private": true,
  "version": "1.0.0",
  "description": "ft_transcendence monorepo",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "lint": "pnpm -r lint",
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "server:dev": "pnpm -w -C apps/server run dev",
    "server:start": "pnpm -w -C apps/server run start"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "bcrypt", "prisma", "sharp", "unrs-resolver"]
  }
}
