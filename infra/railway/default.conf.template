# Railway terminates HTTPS; this gateway keeps browser requests on one origin.
map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}
map $http_x_forwarded_proto $forwarded_scheme {
  default $http_x_forwarded_proto;
  '' $scheme;
}
server {
  listen ${PORT};
  listen [::]:${PORT};
  server_name _;
  location = /health { access_log off; return 200 'ok'; }
  # Allow base64 image uploads (profile pictures) through the proxy.
  client_max_body_size 12m;

  # REST API — strip the /api prefix before forwarding.
  location /api/ {
    proxy_pass http://${SERVER_HOST}:${SERVER_PORT}/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_scheme;
  }

  # Realtime (matchmaking, live match, community chat).
  location /socket.io/ {
    proxy_pass http://${SERVER_HOST}:${SERVER_PORT}/socket.io/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_scheme;
    proxy_read_timeout 600s;
  }

  # Everything else -> Next.js frontend.
  location / {
    proxy_pass http://${CLIENT_HOST}:${CLIENT_PORT};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_scheme;
  }
}
